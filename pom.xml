<?xml version="1.0" encoding="UTF-8"?>
<!--
  MedGuard AI - Maven build file.
  Packaging is "war" because this is a web application deployed on Tomcat.
  Tomcat 10 uses the NEW "jakarta.*" Servlet API (not the old "javax.*").
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.medguard</groupId>
    <artifactId>medguard-ai</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>
    <name>MedGuard AI</name>
    <description>Intelligent Medication Safety Assistant (educational project)</description>

    <properties>
        <!-- release 21 bytecode runs unchanged on Java 21 through Java 25 -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Servlet 6 API for Tomcat 10.1.x. "provided" = Tomcat supplies it at runtime. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSP API (provided by Tomcat as well) -->
        <dependency>
            <groupId>jakarta.servlet.jsp</groupId>
            <artifactId>jakarta.servlet.jsp-api</artifactId>
            <version>3.1.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSTL for Jakarta (c:forEach etc. in JSP). Needed at runtime -> packaged in WAR. -->
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- MySQL JDBC driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <!-- WAR name => app URL becomes http://localhost:8080/medguard/ -->
        <finalName>medguard</finalName>
    </build>
</project>
